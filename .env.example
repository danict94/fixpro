# =============================================================================
# FIXPRO PLATFORM — Environment Variables Template
# Copia questo file in .env e compila tutti i valori.
# MAI committare .env con valori reali nel repository.
# =============================================================================

# --- Database (Neon PostgreSQL) ---
# Connessione principale con connection pooling
DATABASE_URL=""
# Connessione diretta per Prisma Migrate (senza pooler)
DIRECT_URL=""

# --- Admin iniziale (seed) ---
# Usati solo da pnpm db:seed per creare il primo utente admin
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Better Auth ---
# Genera con: openssl rand -base64 32
# Minimo 32 caratteri — app non si avvia senza un valore valido
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# --- Stripe ---
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Dashboard: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""

# --- Twilio (OTP SMS via Verify) ---
# Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_WHATSAPP_CONTENT_SID=""

# --- Resend (Email) ---
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Redis (Rate Limiting) ---
# Upstash per produzione: https://console.upstash.com
# Se non configurato, fallback a in-memory (dev only, non production-safe)
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# --- Google Maps (Places API) ---
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- UploadThing ---
# Dashboard: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# --- Sentry (Error Monitoring) ---
# Dashboard: https://sentry.io
# Optional — if not set, Sentry is disabled (dev only, not recommended for production)
SENTRY_DSN=""

# --- App URLs ---
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_ADMIN_URL=""
