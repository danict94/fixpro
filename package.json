{
  "name": "fixpro-platform",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:push": "turbo run db:push --filter=@fixpro/db",
    "db:generate": "turbo run db:generate --filter=@fixpro/db",
    "db:studio": "turbo run db:studio --filter=@fixpro/db",
    "db:seed": "turbo run db:seed --filter=@fixpro/db",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.4",
    "prettier": "^3.4.2",
    "turbo": "^2.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@sentry/cli",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
